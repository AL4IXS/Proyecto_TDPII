 @model List<Evento>
@using System.Globalization

@{
    var diasSemana = new[] { "Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb" };
    var primerDiaSemana = (DateTime)ViewBag.PrimerDiaSemana;
}

<div class="container my-4">
    <h2 class="text-center">Calendario Semanal</h2>

    <div class="d-flex justify-content-between mb-3">
        <a asp-action="Semana"
           asp-route-semana="@(ViewBag.Semana - 1)"
           asp-route-anio="@ViewBag.Anio"
           class="btn btn-secondary @(ViewBag.Semana == 1 ? "disabled" : "")">
            Semana Anterior
        </a>

        <h4>Semana @ViewBag.Semana (@primerDiaSemana.ToString("dd MMM") - @primerDiaSemana.AddDays(6).ToString("dd MMM yyyy"))</h4>

        <a asp-action="Semana"
           asp-route-semana="@(ViewBag.Semana + 1)"
           asp-route-anio="@ViewBag.Anio"
           class="btn btn-secondary @(ViewBag.Semana == 53 ? "disabled" : "")">
            Semana Siguiente
        </a>
    </div>

    <div class="calendar-container">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th class="time-column">Hora</th>
                    @for (int i = 0; i < 7; i++)
                    {
                        var fechaDia = primerDiaSemana.AddDays(i);
                        <th class="day-column @(fechaDia.Date == DateTime.Today ? "today" : "")">
                            <div>@diasSemana[i]</div>
                            <div>@fechaDia.Day</div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int hour = 6; hour < 22; hour++)
                {
                    <tr>
                        <td class="time-column">@hour:00 - @(hour + 1):00</td>
                        @for (int day = 0; day < 7; day++)
                        {
                            var fechaDia = primerDiaSemana.AddDays(day);
                            var fechaDiaStr = fechaDia.ToString("yyyy-MM-dd");

                            <td class="time-slot">
                                @{
                                    var eventosHora = Model.Where(e =>
                                    {
                                        // Parsear la fecha y hora
                                        if (DateTime.TryParse(e.Fecha, out var fechaEvento) &&
                                            TimeSpan.TryParse(e.HoraInicio, out var horaInicio))
                                        {
                                            return fechaEvento.Date == fechaDia.Date &&
                                                horaInicio.Hours == hour;
                                        }
                                        return false;
                                    }).ToList();
                                }

                                @foreach (var evento in eventosHora)
                                {
                                    <div class="evento" data-toggle="tooltip" title="@evento.Descripcion">
                                        <strong>@evento.Titulo</strong>
                                        <div class="evento-ubicacion">@evento.Ubicacion</div>
                                        <small>@evento.HoraInicio - @evento.HoraFin</small>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .time-slot {
            height: 100px;
            vertical-align: top;
            position: relative;
        }

        .evento {
            background-color: #e3f2fd;
            border-left: 4px solid #2196F3;
            padding: 5px;
            margin: 2px 0;
            border-radius: 3px;
            font-size: 0.85rem;
            cursor: pointer;
        }

            .evento strong {
                display: block;
                font-weight: bold;
            }

        .evento-ubicacion {
            font-size: 0.8rem;
            color: #555;
        }

        .evento small {
            font-size: 0.7rem;
            color: #777;
        }

        .today {
            background-color: #fff8e1 !important;
        }
    </style>
}

@section Scripts {
    <script>
        $(function () {
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}