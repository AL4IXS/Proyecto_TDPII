@model List<Evento>
@using System.Globalization

@{
    DateTime fechaInicio = new DateTime(DateTime.Now.Year, 1, 1);
    List<string> diasSemana = new List<string> { "Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb" };
    ViewData["Title"] = "Calendario Semanal";
}

<div class="container my-4">
    <h2 class="text-center">Calendario Semanal</h2>

    <!-- Formulario para seleccionar la semana y el año -->
    <form id="weekSelector" class="mb-3">
        <label for="semana">Semana:</label>
        <input type="number" id="semana" name="semana" min="1" max="53" value="@ViewBag.Semana" class="form-control d-inline w-auto">

        <label for="anio">Año:</label>
        <input type="number" id="anio" name="anio" value="@ViewBag.Anio" class="form-control d-inline w-auto">

        <button type="submit" class="btn btn-primary">Actualizar</button>
    </form>

    <div class="d-flex justify-content-between mb-3">
        <button id="prevWeek" class="btn btn-secondary">Semana Anterior</button>
        <h4 id="currentWeek"></h4>
        <button id="nextWeek" class="btn btn-secondary">Semana Siguiente</button>
    </div>

    <div class="calendar-container">
        <table class="table table-bordered">
            <thead>
                <tr class="calendar-header">
                    <th class="time-column">Hora</th>
                    @for (int i = 0; i < 7; i++)
                    {
                        <th class="day-column">
                            <span class="day-name">@diasSemana[i]</span>
                            <span class="day-date"></span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int hour = 0; hour < 24; hour++)
                {
                    <tr>
                        <td class="time-column">@hour:00</td>
                        @for (int day = 0; day < 7; day++)
                        {
                            <td class="time-slot">
                                @{
                                    var eventosDeLaSemana = Model.Where(e =>
                                    DateTime.TryParse(e.Fecha, out var fechaConvertida) &&
                                    CultureInfo.InvariantCulture.Calendar.GetWeekOfYear(fechaConvertida, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday) == ViewBag.Semana
                                    && fechaConvertida.Year == ViewBag.Anio).ToList();
                                }

                                @if (eventosDeLaSemana.Any())
                                {
                                    foreach (var evento in eventosDeLaSemana)
                                    {
                                        <div class="evento">
                                            <span>@evento.Titulo</span> - <small>@evento.Ubicacion</small>
                                        </div>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("weekSelector").addEventListener("submit", function (event) {
            event.preventDefault();

            let semana = document.getElementById("semana").value;
            let anio = document.getElementById("anio").value;

            // Redirigir a la misma página con los parámetros semana y año
            window.location.href = `/Home/Semanaaa?semana=${semana}&anio=${anio}`;
        });

        let currentDate = new Date();
        let currentWeekStart = new Date(currentDate.setDate(currentDate.getDate() - currentDate.getDay()));
        const days = document.querySelectorAll(".day-date");
        const currentWeekDisplay = document.getElementById("currentWeek");
        const prevWeekBtn = document.getElementById("prevWeek");
        const nextWeekBtn = document.getElementById("nextWeek");

        function updateCalendar() {
            let weekStart = new Date(currentWeekStart);
            currentWeekDisplay.textContent = `${weekStart.toLocaleDateString()} - ${new Date(weekStart.setDate(weekStart.getDate() + 6)).toLocaleDateString()}`;

            days.forEach((day, index) => {
                let date = new Date(currentWeekStart);
                date.setDate(date.getDate() + index);
                day.textContent = date.getDate();
            });
        }

        prevWeekBtn.addEventListener("click", function () {
            currentWeekStart.setDate(currentWeekStart.getDate() - 7);
            updateCalendar();
        });

        nextWeekBtn.addEventListener("click", function () {
            currentWeekStart.setDate(currentWeekStart.getDate() + 7);
            updateCalendar();
        });

        updateCalendar();
    });
</script>

