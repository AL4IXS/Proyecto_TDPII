@model List<Evento>
@using System.Globalization

@{
    // Obtener fecha del ViewBag como string
    string fechaStr = ViewBag.Fecha?.ToString() ?? DateTime.Today.ToString("yyyy-MM-dd");

    // Parsear a DateTime solo para mostrar formato legible
    DateTime fechaParaMostrar;
    if (!DateTime.TryParse(fechaStr, out fechaParaMostrar))
    {
        fechaParaMostrar = DateTime.Today;
    }

    // Configurar cultura en español
    var cultura = new CultureInfo("es-ES");
    var diaSemana = fechaParaMostrar.ToString("dddd", cultura);
    var mes = fechaParaMostrar.ToString("MMMM", cultura);
}

<div class="container my-4">
    <h2 class="text-center">Calendario Diario</h2>

    <div class="d-flex justify-content-between mb-3">
        <a asp-action="Dia"
           asp-route-fecha="@fechaParaMostrar.AddDays(-1).ToString("yyyy-MM-dd")"
           class="btn btn-secondary">
            Día Anterior
        </a>

        <h4>@diaSemana @fechaParaMostrar.Day de @mes de @fechaParaMostrar.Year</h4>

        <a asp-action="Dia"
           asp-route-fecha="@fechaParaMostrar.AddDays(1).ToString("yyyy-MM-dd")"
           class="btn btn-secondary">
            Día Siguiente
        </a>
    </div>

    <div class="text-center mb-3">
        <input type="date" id="date-picker" value="@fechaStr" class="form-control w-25 mx-auto">
    </div>

    <div class="calendar-container">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th class="time-column">Hora</th>
                    <th class="day-column @(fechaParaMostrar.Date == DateTime.Today ? "today" : "")">
                        Eventos del día
                    </th>
                </tr>
            </thead>
            <tbody>
                @for (int hour = 0; hour < 24; hour++)
                {
                    <tr>
                        <td class="time-column">@hour:00 - @(hour + 1):00</td>
                        <td class="time-slot">
                            @{
                                var eventosHora = Model.Where(e =>
                                {
                                    if (TimeSpan.TryParse(e.hora_inicio, out var horaInicio))
                                    {
                                        return horaInicio.Hours == hour;
                                    }
                                    return false;
                                }).ToList();
                            }

                            @foreach (var evento in eventosHora)
                            {
                                <div class="evento" data-toggle="tooltip" title="@evento.Descripcion">
                                    <strong>@evento.Titulo</strong>
                                    <div class="evento-ubicacion">@evento.Ubicacion</div>
                                    <small>@evento.hora_inicio - @evento.Hora_fin</small>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('[data-toggle="tooltip"]').tooltip();

            $('#date-picker').change(function() {
                window.location.href = '@Url.Action("Dia")' + '?fecha=' + $(this).val();
            });
        });
    </script>
}