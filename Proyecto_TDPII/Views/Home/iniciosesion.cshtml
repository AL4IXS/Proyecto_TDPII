
@{
    ViewData["Title"]="Inicio Sesión";
}


<div class="container">
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="login-tab" data-bs-toggle="tab" data-bs-target="#login" type="button" role="tab">
                Login
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="registro-tab" data-bs-toggle="tab" data-bs-target="#registro" type="button" role="tab">
                Registro
            </button>
        </li>
    </ul>

    <div class="tab-content p-4 border border-top-0">
        <div class="tab-pane fade show active" id="login" role="tabpanel">
            <h2 class="text-center">LOGIN</h2>
            <form>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" placeholder="Escribe tu dirección de correo" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <input type="password" class="form-control" placeholder="Escribe tu contraseña" required>
                </div>
                
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary w-100">Login</button>
                </div>
            </form>
        </div>

        <div class="tab-pane fade" id="registro" role="tabpanel">
            <h2 class="text-center">REGISTRO</h2>
            <form>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" placeholder="usuario@correo.com" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <input type="password" class="form-control" placeholder="Escribe tu contraseña" required>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" placeholder="Tu nombre" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Apellidos</label>
                        <input type="text" class="form-control" placeholder="Tus apellidos"required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Edad</label>
                        <input type="text" class="form-control" placeholder="Tu edad" required>
                    </div>
                </div>




                <div class="mt-3">
                    <button type="submit" class="btn btn-primary w-100">Regístrate</button>
                </div>
            </form>
        </div>
    </div>
</div>
