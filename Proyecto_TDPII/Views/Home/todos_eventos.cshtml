@model List<Proyecto_TDPII.Models.Evento>

<h2 class="text-center mt-4 mb-3">Lista de Eventos</h2>

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark text-center">
            <tr>
                <th>ID</th>
                <th>Titulo</th>
                <th>Fecha</th>
                <th>Hora Inicio</th>
                <th>Hora Fin</th>
                <th>Ubicación</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr class="text-center">
                    <td>@usuario.Id</td>
                    <td>@usuario.Titulo</td>
                    <td>@usuario.Fecha</td>
                    <td>@usuario.hora_inicio</td>
                    <td>@usuario.Hora_fin</td>
                    <td>@usuario.Ubicacion</td>
                    <td>
                        <div>
                            <form asp-action="Editarevento" asp-controller="Home">
                                <input type="hidden" name="id" value="@usuario.Id" />
                                <button type="submit" class="btn btn-sm btn-warning me-1">Editar</button>
                            </form>
                         </div>
                        <div>
                            <form asp-action="Eliminarevento" asp-controller="Home">
                                <input type="hidden" name="id" value="@usuario.Id" />
                                <button type="submit" class="btn btn-sm btn-warning me-1">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>