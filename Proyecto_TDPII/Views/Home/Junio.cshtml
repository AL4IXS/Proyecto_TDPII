@model List<Proyecto_TDPII.Models.Evento>
@{
    ViewData["Title"] = "Mes Junio";
    ViewData["CssFile"] = "~/css/calendario/c_junio.css";
}


<div class=" col py-3">
    <div id="contenedor">
        <div class="card">
            <div class="mes card-header">
                <div class="btn-group btn-group-sm">
                    <a asp-action="Mayo" class="btn btn-secondary">Anterior</a>
                    <a asp-action="Julio" class="btn btn-secondary">Siguiente</a>
                </div>
                <h1 class="nombre__mes">Junio 2025</h1>

            </div>
            <div class="card-body">
                <section class="dias d-flex justify-content-around mb-2">
                    <div class="dias__item">Lunes</div>
                    <div class="dias__item">Martes</div>
                    <div class="dias__item">Miercoles</div>
                    <div class="dias__item">Jueves</div>
                    <div class="dias__item">Viernes</div>
                    <div class="dias__item">Sabado</div>
                    <div class="dias__item">Domingo</div>
                </section>
                <section class="calendario">
                    <div class="calendario__dia prev"> 26</div>
                    <div class="calendario__dia prev"> 27</div>
                    <div class="calendario__dia prev"> 28</div>
                    <div class="calendario__dia prev"> 29</div>
                    <div class="calendario__dia prev"> 30</div>
                    <div class="calendario__dia prev"> 31</div>
                    @for (int dia = 1; dia <= 30; dia++)
                    {
                        if (dia == 1)
                        {
                            var eventosDelDia = Model.Where(e => DateTime.TryParse(e.Fecha, out var fechaConvertida) && fechaConvertida.Day == dia).ToList();
                            <div class="calendario__dia first-day">
                                <strong>@dia</strong>
                                @if (eventosDelDia.Any())
                                {
                                    foreach (var evento in eventosDelDia)
                                    {
                                        <div class="evento">
                                            <span>@evento.Titulo</span> - <small>@evento.Ubicacion</small>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            var eventosDelDia = Model.Where(e => DateTime.TryParse(e.Fecha, out var fechaConvertida) && fechaConvertida.Day == dia).ToList();
                            <div class="calendario__dia">
                                <strong>@dia</strong>
                                @if (eventosDelDia.Any())
                                {
                                    foreach (var evento in eventosDelDia)
                                    {
                                        <div class="evento">
                                            <span>@evento.Titulo</span> - <small>@evento.Ubicacion</small>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                </section>
            </div>
        </div>
    </div>
</div>