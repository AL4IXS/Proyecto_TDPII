@{
    ViewData["Title"] = "Semana";
    ViewData["CssFile"] = "~/css/calendario/semana.css";
    ViewData["JsFile"] = "~/js/modal.js";
}

<div id="modal" class="modal">
    <div class="modal-dialog">
        <div class="calendar modal-content">
    <section class="form-register">
        <button type="button" class="cerrar btn-close btn-close-white" aria-label="Close"></button>
        <h3 for="Evento"><strong>Evento</strong></h3>
        <input class="controls form-control-sm" type="text" name="titulo" id="titulo" placeholder="Ingresa el titulo" aria-label=".form-control-sm">
        <label for="horaFinalizacion">Ingresa la fecha:</label>
        <input class="controls" type="date" name="fecha" id="fecha" placeholder="Ingresa la fecha">
        <label for="horaInicio">Hora de Inicio:      </label>
        <input class="controls2" type="time" name="horaI" id="horaI" placeholder="Ingresa la hora">
        <label for="horaFinalizacion">Hora de Finalizacion:</label>
        <input class="controls2" type="time" name="horaF" id="horaF" placeholder="Ingresa la hora">
        <input class="controls" type="text" name="ubicacion" id="ubicacion" placeholder="Ingresa la ubicacion">
        <textarea class="controls" id="descripcion" rows="5" placeholder="Ingresa una descripcion (opcional)"></textarea>
        <input id="btn-cerrar-modal" class="bottons btn-primary" type="button" value="Guardar">
    </section>
</div>
</div>
</div>

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#myModal">
    Open modal
</button>

<!-- The Modal -->
<div class="modal" id="myModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Modal Heading</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                Modal body..
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>