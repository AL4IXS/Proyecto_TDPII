<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proyecto_TDPII</title>
    <link rel="stylesheet" href="~/css/calendario/semana.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @if (ViewData["CssFile"] != null)
    {
        <link rel="stylesheet" href="@Url.Content(ViewData["CssFile"].ToString())" />
    }
</head>
<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-dark">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">
                    <a asp-area="" asp-controller="Home" asp-action="iniciosesion" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                        <img src="~/img/calemi.png" height="25px" alt="Icono Calendario" loading="lazy" class="me-2" />
                        <span class="fs-5 d-none d-sm-inline">Agenda</span>
                    </a>
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                        <li class="nav-item">
                            <a href="#" class="nav-link align-middle px-0">
                                <i class="fs-4 bi-house"></i> <a asp-area="" asp-controller="Home" asp-action="iniciosesion"><span class="text-white ms-1 d-none d-sm-inline">Inicio</span></a>
                            </a>
                        </li>
                        <li>
                            <a href="#submenu1" data-bs-toggle="collapse" class=" nav-link px-0 align-middle">
                                <i class="fs-4 bi-speedometer2"></i> <span class="text-white ms-1 d-none d-sm-inline">Ver mas +</span>
                            </a>
                            <ul class="collapse show nav flex-column ms-1" id="submenu1" data-bs-parent="#menu">
                                <li class="w-100">
                                    <a class="nav-link px-0" asp area="" asp-controller="Home" asp-action="dia"><span class="text-white d-none d-sm-inline">Dia</span></a>
                                </li>
                                <li>
                                    <a class="nav-link px-0" asp area="" asp-controller="Home" asp-action="semanaaa"> <span class="text-white d-none d-sm-inline">Semana</span></a>
                                </li>
                            </ul>
                        </li>
                        <li>
                            <a href="#submenu2" data-bs-toggle="collapse" class="nav-link px-0 align-middle">
                                <i class="fs-4 bi-bootstrap"></i>
                                <span class="text-white ms-1 d-none d-sm-inline">Agregar +</span>
                            </a>
                            <ul class="collapse nav flex-column ms-1" id="submenu2" data-bs-parent="#menu">
                                <li class="w-100">
                                    <a class="nav-link px-8" asp-area="" asp-controller="Home" asp-action="agregarevento">
                                        Evento
                                    </a>
                                </li>
                                
                            </ul>
                        </li>
                        <li>
                            
                            <ul class="collapse nav flex-column ms-1" id="submenu3" data-bs-parent="#menu">
                                <li class="w-100">
                                    <a class="nav-link px-8" asp-area="" asp-controller="Home" asp-action="habitos">
                                        Ver
                                    </a>
                                </li>
                                <li>
                                    <a href="#" class="nav-link px-0">
                                        <span class="text-white d-none d-sm-inline">Tarea</span>
                                    </a>
                                </li>
                            </ul>
                        </li>

                       <li>
                            <a class="nav-link px-8" asp-area="" asp-controller="Home" asp-action="todos_eventos">
                                Ver eventos
                            </a>
                       </li>

                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="lista" class="nav-link px-0 align-middle">
                                <i class="fs-4 bi-table"></i> <span class="text-white d-none d-sm-inline">Eliminar</span>
                            </a>
                        </li>

                        <li>
                            <div class="dropdown mt-2">
                                <button type="button" class="btn btn-primary dropdown-toggle" style="background-color: rgba(77,77,77,0.25)" data-bs-toggle="dropdown">
                                    Selecciona el mes
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp area="" asp-controller="Home" asp-action="Enero">Enero</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Febrero">Febrero</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Marzo">Marzo</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Abril">Abril</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Mayo">Mayo</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Junio">Junio</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Julio">Julio</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Agosto">Agosto</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Septiembre">Septiembre</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Octubre">Octubre</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Noviembre">Noviembre</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Diciembre">Diciembre</a></li>
                                </ul>
                            </div>
                        </li>

                        <hr class="mt-auto" />

                        <li class="dropdown mt-auto">
                            <a href="#" class="nav-link px-0 align-middle dropdown-toggle" data-bs-toggle="dropdown">
                                <img src="~/img/usro.png" height="25px" width="25px" class="me-2" />
                                <span class="text-white d-none d-sm-inline">Usuario</span>
                            </a>
                            <ul class="dropdown-menu text-small shadow">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="index">Iniciar Sesión</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="">Cerrar Sesión</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link align-middle px-0">
                                <i class="fs-4 bi-box-arrow-right"></i> <span class="text-white ms-1 d-none d-sm-inline">Salir</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="container">
                <main role="main">
                    @RenderBody()
                </main>
            </div>

        </div>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/modal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>