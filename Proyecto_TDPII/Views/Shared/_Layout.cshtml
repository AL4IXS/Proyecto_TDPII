<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proyecto_TDPII</title>
    <link rel="stylesheet" href="~/css/calendario/semana.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @if (ViewData["CssFile"] != null)
    {
        <link rel="stylesheet" href="@Url.Content(ViewData["CssFile"].ToString())" />
    }
</head>
<body>
    <header>
        <nav class="navbar navbar-light bg-dark py-0">
            <div class="container-fluid d-flex align-items-center justify-content-between">
               
                <div class="d-flex align-items-center">
                    <a class="navbar-brand me-2">
                        <img src="~/img/icono_calendario.png" height="25px" alt="Icono Calendario" loading="lazy" />
                    </a>
                    <span class="navbar-brand mb-0 h5 text-white">Agenda</span>
                </div>

                
                <form class="d-flex input-group w-25">
                    <input type="search" class="form-control" placeholder="Search" aria-label="Search" aria-describedby="search-addon" style="border-radius: 30px 0 0 30px;" />
                    <button class="btn btn-info" type="submit" id="btn_busqueda" style="border-radius: 0 30px 30px 0; padding: 5px;">
                        <img src="~/img/lpa.png" width="20px" height="20px" class="text-center" />
                    </button>
                </form>

                
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center p-3 link-dark text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="~/img/usro.png" height="25px" width="25px"/>
                    </a>
                    <ul class="dropdown-menu text-small shadow" aria-labelledby="dropdownUser3">
                        <li><a class="dropdown-item" href="#">Perfil</a></li>
                        <li><a class="dropdown-item" href="#">Cerrar Sesión</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row flex-nowrap">
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-dark">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">
                    <a href="/" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                        <span class="fs-5 d-none d-sm-inline">Menu</span>
                    </a>
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                        <li class="nav-item">
                            <a href="#" class="nav-link align-middle px-0">
                                <i class="fs-4 bi-house"></i> <a asp-area="" asp-controller="Home" asp-action="Index"><span class="text-white ms-1 d-none d-sm-inline">Home</span></a>
                            </a>
                        </li>
                        <li>
                            <a href="#submenu1" data-bs-toggle="collapse" class=" nav-link px-0 align-middle">
                                <i class="fs-4 bi-speedometer2"></i> <span class="text-white ms-1 d-none d-sm-inline">Ver mas +</span>
                            </a>
                            <ul class="collapse show nav flex-column ms-1" id="submenu1" data-bs-parent="#menu">
                                <li class="w-100">
                                    <a class="nav-link px-0" asp area="" asp-controller="Home" asp-action="dia"><span class="text-white d-none d-sm-inline">Dia</span></a>
                                </li>
                                <li>
                                    <a class="nav-link px-0" asp area="" asp-controller="Home" asp-action="Semana"> <span class="text-white d-none d-sm-inline">Semana</span></a>
                                </li>
                            </ul>
                        </li>
                        <li>
                            <a href="#submenu2" data-bs-toggle="collapse" class="nav-link px-0 align-middle ">
                                <i class="fs-4 bi-bootstrap"></i> <span class="text-white ms-1 d-none d-sm-inline">Agregar +</span>
                            </a>
                            <ul class="collapse nav flex-column ms-1" id="submenu2" data-bs-parent="#menu">
                                <li class="w-100">
                                    <a class="nav-link px-8" data-bs-toggle="modal" data-bs-target="#myModal" asp area="" asp-controller="Home" asp-action="Semana">
                                        Evento
                                    </a>
                                </li>
                                <li>
                                    <a href="#" class="nav-link px-0"> <span class="text-white d-none d-sm-inline">Tarea</span></a>
                                </li>
                            </ul>
                        </li>
                        <li>
                            <a href="#" class="nav-link px-0 align-middle">
                                <i class="fs-4 bi-table"></i> <span class="text-white ms-1 d-none d-sm-inline">Editar </span>
                            </a>
                        </li>
                        <li>
                            <a  asp-area="" asp-controller="Home" asp-action="lista" class="nav-link px-0 align-middle">
                                <!--<a class="nav-link px-0" asp area="" asp-controller="Home" asp-action="Semana"> <span class="text-white d-none d-sm-inline">Semana</span></a>-->

                                <i class="fs-4 bi-table"></i> <span class="text-white  d-none d-sm-inline">Eliminar</span>
                            </a>
                        </li>

                        <hr>

                        <li>
                            <div class="dropdown">
                                <button type="button" class="btn btn-primary dropdown-toggle" style="background-color: rgba(77,77,77,0.25)" data-bs-toggle="dropdown">
                                    Selecciona el mes
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp area="" asp-controller="Home" asp-action="Enero">Enero</a></li>
                                    <!--<a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> -->
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Febrero">Febrero</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Marzo">Marzo</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Abril">Abril</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Mayo">Mayo</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Junio">Junio</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Julio">Julio</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Agosto">Agosto</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Septiembre">Septiembre</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Octubre">Octubre</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Noviembre">Noviembre</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Diciembre">Diciembre</a></li>

                                </ul>
                            </div>
                        </li>
                    </ul>
                    <hr>
                </div>
            </div>

            <div class="container">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
            
        </div>
    </div>

    <div class="modal" id="myModal">
        <div class="modal-dialog">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header bg-black">
                    <h3 for="Evento" class="text-white"><strong>Evento</strong></h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body bg-black">
                    <section class="form-register">
                        <input class="controls form-control-sm" type="text" name="titulo" id="titulo" placeholder="Ingresa el titulo" aria-label=".form-control-sm">
                        <label for="horaFinalizacion">Ingresa la fecha:</label>
                        <input class="controls" type="date" name="fecha" id="fecha" placeholder="Ingresa la fecha">
                        <label for="horaInicio">Hora de Inicio:      </label>
                        <input class="controls2" type="time" name="horaI" id="horaI" placeholder="Ingresa la hora">
                        <label for="horaFinalizacion">Hora de Finalizacion:</label>
                        <input class="controls2" type="time" name="horaF" id="horaF" placeholder="Ingresa la hora">
                        <input class="controls" type="text" name="ubicacion" id="ubicacion" placeholder="Ingresa la ubicacion">
                        <textarea class="controls" id="descripcion" rows="5" placeholder="Ingresa una descripcion (opcional)"></textarea>
                        <input id="btn-cerrar-modal" class="bottons btn-primary" type="button" value="Guardar">
                    </section>
                </div>

                <!-- Modal footer -->
                <div class="modal-footer bg-black">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                </div>

            </div>
        </div>
    </div>


    

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Proyecto_TDPII - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/modal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
