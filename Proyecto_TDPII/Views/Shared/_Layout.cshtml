<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proyecto_TDPII</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @if (ViewData["CssFile"] != null)
    {
        <link rel="stylesheet" href="@Url.Content(ViewData["CssFile"].ToString())" />
    }
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-light navbar-light border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/img/icono_calendario.png" style="height:40px; width:50px;" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav  mx-auto gap-5">
                        <li class="nav-item me-5 px-3">
                            <label for="rdbt_1" class="form-check-label">Importante 1 </label>
                            <input type="radio" class="form-check-input" id="rdbt_2" name="rd" />
                            <!--  <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>  -->
                        </li>
                        <li class="nav-item me-5 px-3">
                            <label for="rdbt_2" class="form-check-label">Importante 2 </label>
                            <input type="radio" class="form-check-input" id="rdbt_1" name="rd" />
                            <!--  <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>   -->
                        </li>
                        <li class="nav-item me-5 px-3">
                           
                            <label for="rdbt_3" class="form-check-label">Importante 3 </label>
                            <input type="radio" class="form-check-input" id="rdbt_3" name="rd" />
                            <!--<a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> -->
                        </li>
                        <li class="nav-item me-5 px-3">

                            <label for="rdbt_4" class="form-check-label">Importante 4 </label>
                            <input type="radio" class="form-check-input" id="rdbt_4" name="rd" />
                            <!--<a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> -->
                        </li>
                    </ul>
                    <form class="d-flex" role="BuscarEvento">
                        <input class="form-control me-2" type="search" placeholder="Buscar Evento" aria-label="BuscarEvento">
                        <button class="btn btn-outline-success" type="submit">Buscar</button>
                    </form>
                </div>
            </div>
        </nav>
    </header>


    <div class="container-fluid">
        <div class="row flex-nowrap">
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-dark">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">
                    <a href="/" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                        <span class="fs-5 d-none d-sm-inline">Menu</span>
                    </a>
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                        <li class="nav-item">
                            <a href="#" class="nav-link align-middle px-0">
                                <i class="fs-4 bi-house"></i> <a asp-area="" asp-controller="Home" asp-action="Index"><span class="text-white ms-1 d-none d-sm-inline">Home</span></a>
                            </a>
                        </li>
                        <li>
                            <a href="#submenu1" data-bs-toggle="collapse" class=" nav-link px-0 align-middle">
                                <i class="fs-4 bi-speedometer2"></i> <span class="text-white ms-1 d-none d-sm-inline">Ver mas +</span>
                            </a>
                            <ul class="collapse show nav flex-column ms-1" id="submenu1" data-bs-parent="#menu">
                                <li class="w-100">
                                    <a href="#" class="nav-link px-0"> <span class="text-white d-none d-sm-inline">Dia</span></a>
                                </li>
                                <li>
                                    <a href="#" class="nav-link px-0"> <span class="text-white d-none d-sm-inline">Semana</span></a>
                                </li>
                            </ul>
                        </li>
                        <li>
                            <a href="#submenu2" data-bs-toggle="collapse" class="nav-link px-0 align-middle ">
                                <i class="fs-4 bi-bootstrap"></i> <span class="text-white ms-1 d-none d-sm-inline">Agregar +</span>
                            </a>
                            <ul class="collapse nav flex-column ms-1" id="submenu2" data-bs-parent="#menu">
                                <li class="w-100">
                                    <a href="#" class="nav-link px-0"> <span class="text-white d-none d-sm-inline">Evento</span></a>
                                </li>
                                <li>
                                    <a href="#" class="nav-link px-0"> <span class="text-white d-none d-sm-inline">Tarea</span></a>
                                </li>
                            </ul>
                        </li>
                        <li>
                            <a href="#" class="nav-link px-0 align-middle">
                                <i class="fs-4 bi-table"></i> <span class="text-white ms-1 d-none d-sm-inline">Editar </span>
                            </a>
                        </li>
                        <li>
                            <a href="#" class="nav-link px-0 align-middle">
                                <i class="fs-4 bi-table"></i> <span class="text-white  d-none d-sm-inline">Eliminar</span>
                            </a>
                        </li>

                        <hr>

                        <li>
                            <div class="dropdown">
                                <button type="button" class="btn btn-primary dropdown-toggle" style="background-color: rgba(77,77,77,0.25)" data-bs-toggle="dropdown">
                                    Selecciona el mes
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp area="" asp-controller="Home" asp-action="Enero">Enero</a></li>
                                    <!--<a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> -->
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Febrero">Febrero</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Marzo">Marzo</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Abril">Abril</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Mayo">Mayo</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Junio">Junio</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Julio">Julio</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Agosto">Agosto</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Septiembre">Septiembre</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Octubre">Octubre</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Noviembre">Noviembre</a></li>
                                    <li><a class="dropdown-item" asp asp-area="" asp-controller="Home" asp-action="Diciembre">Diciembre</a></li>

                                </ul>
                            </div>
                        </li>
                    </ul>
                    <hr>
                </div>
            </div>

            <div class="container">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
            
        </div>
    </div>


    

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Proyecto_TDPII - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
